---
// Hero.astro — Full-viewport hero section.
// Layout: texto izq (60%) + contenedor 3D derecha (40%).
// Reglas: sin sombras, sin gradientes, sin emojis.
---
<section class="hero" aria-labelledby="hero-headline">

  <div class="container hero__inner">

    <!-- Columna izquierda: texto -->
    <div class="hero__text">

      <p class="hero__overline">Cuautitlán Izcalli</p>

      <h1 id="hero-headline" class="hero__headline headline">
        Diferente<br />
        <span class="accent">Entrena</span><br />
        Diferente
      </h1>

      <p class="hero__body">
        El gimnasio que te exige tanto como tú mismo.<br />
        Sin excusas. Sin límites.
      </p>

      <div class="hero__actions">
        <a href="#contacto" class="btn btn--primary">Empieza hoy</a>
        <a href="#nosotros" class="btn btn--ghost">Conoce el gym</a>
      </div>

    </div>

    <!-- Columna derecha: reservada para modelo 3D -->
    <div class="hero__3d" id="hero-3d" aria-hidden="true"></div>

  </div>

  <!-- Indicador de scroll -->
  <p class="hero__scroll" aria-hidden="true">Desliza</p>

  <!-- Bottom divider -->
  <hr class="divider" />

</section>

<style>
  /* ── Sección ───────────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--sp-8) var(--sp-8);
    position: relative;
  }

  /* ── Layout principal: columnas en desktop ─────────────────── */
  .hero__inner {
    display: grid;
    /* móvil: columna única, invertida (3D arriba, texto abajo) */
    grid-template-columns: 1fr;
    grid-template-rows: 45svh auto;
    gap: var(--sp-6);
    align-items: end;
  }

  /* En desktop: dos columnas lado a lado */
  @media (min-width: 768px) {
    .hero__inner {
      grid-template-columns: 60fr 40fr;
      grid-template-rows: auto;
      align-items: center;
      min-height: calc(100svh - var(--sp-16));
    }
  }

  /* ── Columna texto ─────────────────────────────────────────── */
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    /* en móvil: aparece debajo del contenedor 3D (orden natural) */
    order: 2;
  }

  @media (min-width: 768px) {
    .hero__text {
      order: 1;
      gap: var(--sp-6);
    }
  }

  /* ── Overline ──────────────────────────────────────────────── */
  .hero__overline {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border-left: 2px solid var(--red);
    padding-left: var(--sp-3);
  }

  /* ── Titular fluido ────────────────────────────────────────── */
  /*
     Escala recalculada para no romperse en 360px:
     - 360px → ~48px (3rem)
     - 390px → ~52px
     - 768px → ~80px
     - 1440px → ~108px (6.75rem)
     Fórmula: clamp(3rem, 11.5vw + 0.5rem, 6.75rem)
  */
  .hero__headline {
    font-size: clamp(3rem, 11.5vw + 0.5rem, 6.75rem);
    max-width: 12ch;
    /* line-height y uppercase vienen de .headline en global.css */
  }

  /* ── Cuerpo ────────────────────────────────────────────────── */
  .hero__body {
    font-size: var(--fs-sm);
    color: var(--muted);
    max-width: 36ch;
    line-height: 1.7;
  }

  /* ── CTAs ──────────────────────────────────────────────────── */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
  }

  /* ── Contenedor 3D ─────────────────────────────────────────── */
  .hero__3d {
    /* móvil: aparece arriba (order 1), altura 45svh */
    order: 1;
    height: 45svh;
    width: 100%;
    border: var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    /* Placeholder visual discreto — sin gradientes */
    position: relative;
  }

  /* Label de placeholder (se quita cuando llegue el 3D) */
  .hero__3d::after {
    content: '3D';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--line);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .hero__3d {
      order: 2;
      height: 100%;
      min-height: 420px;
      /* quita el borde en desktop si prefieres invisible */
    }
  }

  /* ── Indicador scroll ──────────────────────────────────────── */
  .hero__scroll {
    position: absolute;
    bottom: var(--sp-6);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;       /* 12px fijo */
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.6;
    animation: scroll-pulse 2.4s var(--ease) infinite;
    white-space: nowrap;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.6; transform: translateX(-50%) translateY(0); }
    50%       { opacity: 1;   transform: translateX(-50%) translateY(4px); }
  }

  /* ── Botones ───────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-sm);
    padding: var(--sp-3) var(--sp-6);
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      color            var(--dur) var(--ease),
      border-color     var(--dur) var(--ease);
    white-space: nowrap;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .btn--primary {
    background-color: var(--red);
    color: var(--text);
    border-color: var(--red);
  }
  .btn--primary:hover,
  .btn--primary:focus-visible {
    background-color: #b80f17;
    border-color: #b80f17;
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--text);
    border-color: var(--line);
  }
  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    border-color: var(--muted);
  }

  .btn:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
</style>
