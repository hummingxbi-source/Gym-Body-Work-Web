---
import { Picture } from 'astro:assets';
import facilityNave from '../assets/photos/facility-nave.jpg';
import facilityJaulas from '../assets/photos/facility-jaulas-real.jpg';
import facilitySauna from '../assets/photos/facility-sauna-real.jpg';
import facilityRegaderas from '../assets/photos/facility-regaderas-real.jpg';

const imgMain = facilityNave;
const imgCages = facilityJaulas;
const imgSauna = facilitySauna;
const imgShowers = facilityRegaderas;

const items = [
  {
    id: '01',
    title: 'Nave Central',
    desc: 'Amplia variedad de peso libre y máquinas bajo un techo arqueado.',
    img: imgMain,
    alt: 'Zona de peso libre con barras, discos y racks rojos sobre pasto sintético',
    objPos: '50% 55%',
    class: 'fac-card--main'
  },
  {
    id: '02',
    title: 'Jaulas de Bateo',
    desc: 'Perfecciona tu técnica sin salir del club.',
    img: imgCages,
    alt: 'Túnel de jaulas de bateo con red negra, home plate y pelotas sobre pasto sintético',
    objPos: '50% 62%',
    class: 'fac-card--cages'
  },
  {
    id: '03',
    title: 'Sauna',
    desc: 'Relajación y recuperación.',
    img: imgSauna,
    alt: 'Interior del sauna con bancas de madera',
    objPos: '50% 60%',
    class: 'fac-card--small'
  },
  {
    id: '04',
    title: 'Regaderas',
    desc: 'Privacidad y limpieza.',
    img: imgShowers,
    alt: 'Área de regaderas individuales con muros de azulejo y banca',
    objPos: '40% 50%',
    class: 'fac-card--small'
  }
];
---

<section class="facilities section-reveal" id="instalaciones" aria-labelledby="facilities-title">
  <div class="container">
    <div class="facilities__header">
      <p class="overline">Instalaciones</p>
      <h2 id="facilities-title" class="headline facilities__title">Todo en un solo lugar</h2>
    </div>

    <div class="fac-grid">
      {items.map((item) => (
        <a href="#contacto" class={`fac-card ${item.class}`} aria-label={item.title}>
          <div class="fac-card__img-wrap">
            {item.img && (
              <Picture 
                src={item.img} 
                alt={item.alt}
                width={1600}
                height={2000}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200, 1600]}
                sizes="(max-width: 991px) 85vw, (max-width: 1200px) 50vw, 33vw"
                loading="lazy"
                decoding="async"
                class="fac-card__img" 
                style={`object-position: ${item.objPos};`}
              />
            )}
          </div>
          <div class="fac-card__overlay">
            <span class="fac-card__num" aria-hidden="true">{item.id} / 04</span>
            <div class="fac-card__text">
              <h3 class="headline fac-card__title">{item.title}</h3>
              <p class="fac-card__desc">{item.desc}</p>
            </div>
            {item.illustrative && <span class="fac-card__illustrative">Imagen ilustrativa</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .facilities {
    padding-block: var(--sp-24);
    background-color: var(--bg);
  }

  .facilities__header {
    margin-bottom: var(--sp-12);
  }

  .facilities__title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: var(--text);
    margin: 0;
  }

  /* Overline (reused) */
  .overline {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border-left: 2px solid var(--red);
    padding-left: var(--sp-3);
    margin-bottom: var(--sp-6);
  }

  /* Grid Layout (Desktop) */
  .fac-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 400px 350px;
    gap: var(--sp-4);
  }

  .fac-card--main { grid-column: 1 / 3; grid-row: 1 / 3; }
  .fac-card--cages { grid-column: 3 / 5; grid-row: 1 / 2; }
  .fac-card--small:nth-of-type(3) { grid-column: 3 / 4; grid-row: 2 / 3; }
  .fac-card--small:nth-of-type(4) { grid-column: 4 / 5; grid-row: 2 / 3; }

  /* Card Base */
  .fac-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--surface);
    text-decoration: none;
    outline: none;
  }

  .fac-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease);
    z-index: 10;
  }

  .fac-card__img-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .fac-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease-out;
  }

  /* Gradient Overlay */
  .fac-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-6);
    background: linear-gradient(
      to bottom,
      rgba(11, 11, 12, 0) 0%,
      rgba(11, 11, 12, 0.2) 60%,
      rgba(11, 11, 12, 0.9) 100%
    );
  }

  /* Typography */
  .fac-card__num {
    align-self: flex-end;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    color: var(--text);
  }

  .fac-card__text {
    margin-top: auto;
  }

  .fac-card__title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text);
    margin: 0 0 var(--sp-2) 0;
  }

  .fac-card__desc {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text);
    opacity: 0.9;
    margin: 0;
  }

  .fac-card__illustrative {
    position: absolute;
    bottom: var(--sp-2);
    right: var(--sp-3);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text);
    opacity: 0.6;
    text-transform: uppercase;
  }

  /* Interaction (Desktop only) */
  @media (min-width: 992px) {
    .fac-card:hover .fac-card__img,
    .fac-card:focus-visible .fac-card__img {
      transform: scale(1.04);
    }
    
    .fac-card:hover::after,
    .fac-card:focus-visible::after {
      transform: scaleX(1);
    }
    
    .fac-card:focus-visible {
      box-shadow: 0 0 0 4px var(--bg), 0 0 0 6px var(--red);
    }
  }

  /* Mobile Carousel */
  @media (max-width: 991px) {
    .fac-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: var(--sp-4);
      padding-bottom: var(--sp-4);
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    
    .fac-grid::-webkit-scrollbar {
      display: none;
    }

    .fac-card {
      flex: 0 0 85%;
      height: 450px;
      scroll-snap-align: center;
    }

    /* Keep hover line visible on mobile by default to show it's clickable */
    .fac-card::after {
      transform: scaleX(1);
    }
  }
</style>
