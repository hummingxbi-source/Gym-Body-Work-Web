---
// src/pages/lab/dumbbell-glb.astro
// Página de prueba aislada — GLB optimizado con MeshoptDecoder.
// NO indexar — noindex en meta.
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab: Mancuerna GLB — Body Work Gym</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%; height: 100%;
        background: #0b0b0c;
        overflow: hidden;
        font-family: system-ui, sans-serif;
      }
      #lab-wrap {
        position: fixed;
        inset: 0;
      }
      #dumbbell-canvas {
        display: block;
        width: 100%;
        height: 100%;
      }
      #lab-label {
        position: fixed;
        top: 1rem;
        left: 1rem;
        font-size: 0.7rem;
        font-weight: 500;
        color: #8a8a90;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        pointer-events: none;
        user-select: none;
      }
      #lab-hint {
        position: fixed;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.68rem;
        color: #4a4a4e;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        pointer-events: none;
        white-space: nowrap;
      }
      #lab-loading {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        color: #4a4a4e;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        background: #0b0b0c;
        transition: opacity 0.5s ease;
        pointer-events: none;
      }
      #lab-loading.hidden {
        opacity: 0;
      }
    </style>
  </head>
  <body>
    <div id="lab-wrap">
      <canvas id="dumbbell-canvas"></canvas>
    </div>
    <p id="lab-label">LAB / Mancuerna GLB</p>
    <p id="lab-hint">856 KB · 50k triángulos · EXT_meshopt_compression</p>
    <div id="lab-loading">Cargando modelo...</div>

    <script type="module">
      // ── Carga diferida para no bloquear el primer render ──────────────────
      const canvas  = document.getElementById('dumbbell-canvas');
      const loading = document.getElementById('lab-loading');

      // Esperamos un frame para que el navegador pinte el fondo antes de
      // iniciar la carga pesada de Three.js + GLTFLoader
      requestAnimationFrame(() => {
        import('/src/scripts/dumbbell-glb-scene.js')
          .then(({ initGLBScene }) => initGLBScene(canvas))
          .then(() => {
            loading.classList.add('hidden');
            setTimeout(() => loading.remove(), 600);
          })
          .catch(err => {
            loading.textContent = 'Error: ' + err.message;
            console.error(err);
          });
      });
    </script>
  </body>
</html>
